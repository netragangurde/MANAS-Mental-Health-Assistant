# Select provider: gemini or openai
LLM_PROVIDER=gemini

# Gemini API (recommended for this demo)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI alternative (optional; only used if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional SMTP/Gmail App Password configuration
SENDER_MAIL_ID=your_sender_email@example.com
APP_PASSWORD=your_gmail_app_password_here
RECEIVER_EMAIL_1=your_receiver_email@example.com
RECEIVER_EMAIL_2=
RECEIVER_EMAIL_3=
